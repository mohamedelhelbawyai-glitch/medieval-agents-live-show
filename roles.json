{
  "_comment": "Characters are jobs, not people. 'jobs' define a look, a home place and name patterns (regex, matched against the agent's role id): any agent whose role id matches a job's patterns takes that job. 'roles' pin a specific agent name to a job and add a specialty (second line of the nameplate). Order matters: the first job that matches wins, so specific jobs come first. Places: castle, library, forge, barracks, market, docks, farm, tavern, arena, theatre.",
  "jobs": {
    "Swordsman": {
      "look": "swordsman",
      "home": "barracks",
      "match": [
        "debug",
        "(^|-)bug",
        "fix(er)?($|-)",
        "hotfix",
        "incident",
        "troubleshoot",
        "triage",
        "(^|-)issue",
        "regression",
        "firefight"
      ],
      "tasks": [
        "Hunts down bugs, issues and mistakes",
        "Enemies appear while a fix is in progress; they fall when it is fixed",
        "Falls in battle if the fix fails"
      ]
    },
    "Keeper of the Arsenal": {
      "look": "arsenal",
      "home": "docks",
      "match": [
        "deploy",
        "release",
        "devops",
        "(^|-)(ci|cd)($|-)",
        "(^|-)ship",
        "publish",
        "(^|-)infra",
        "(^|-)sre($|-)",
        "rollout",
        "pipeline"
      ],
      "tasks": [
        "Deploys and releases",
        "Guards the pipeline and the build artefacts"
      ]
    },
    "Royal Scribe": {
      "look": "scribe",
      "home": "library",
      "match": [
        "report",
        "scribe",
        "summar",
        "changelog",
        "release-notes",
        "status-update"
      ],
      "tasks": [
        "Writes reports and summaries",
        "Presents results on the theatre stage"
      ]
    },
    "Keeper of Records": {
      "look": "archivist",
      "home": "farm",
      "match": [
        "context",
        "(^|-)record",
        "memory",
        "(^|-)docs?($|-)",
        "documentation",
        "knowledge",
        "markdown",
        "archiv",
        "(^|-)notes?($|-)"
      ],
      "tasks": [
        "Keeps the context: markdown files, notes and memory",
        "Context engineering for the other agents"
      ]
    },
    "Chancellor": {
      "look": "chancellor",
      "home": "castle",
      "match": [
        "analyst",
        "business",
        "requirement",
        "clarif",
        "intake",
        "(^|-)specs?($|-)",
        "specification",
        "product",
        "stakeholder",
        "(^|-)ba($|-)",
        "explor",
        "research",
        "investigat",
        "discovery",
        "user-stor"
      ],
      "tasks": [
        "Gathers requirements and clarifies them",
        "Turns requests into specifications"
      ]
    },
    "Guild Inspector": {
      "look": "inquisitor",
      "home": "arena",
      "match": [
        "(^|-)qa($|-)",
        "quality",
        "test",
        "verif",
        "inspect",
        "audit",
        "validat",
        "acceptance",
        "benchmark",
        "(^|-)perf"
      ],
      "tasks": [
        "Checks the work: tests, QA, verification",
        "Runs the suite and checks every acceptance scenario with evidence"
      ]
    },
    "Master Craftsmen": {
      "look": "master",
      "home": "library",
      "match": [
        "code-review",
        "review",
        "(^|-)architect",
        "(^|-)design",
        "senior",
        "(^|-)lint"
      ],
      "tasks": [
        "Reviews code and designs",
        "Read-only: reports findings, the caller decides what to fix"
      ]
    },
    "Royal Steward": {
      "look": "steward",
      "home": "castle",
      "match": [
        "orchestrat",
        "conduct",
        "coordinat",
        "manager",
        "(^|-)lead($|-)",
        "planner",
        "steward",
        "supervis",
        "(^|-)main($|-)"
      ],
      "tasks": [
        "Routes work to the right agent",
        "Plans tasks and hands work off between phases"
      ]
    },
    "Craftsman": {
      "look": "worker",
      "home": "forge",
      "match": [
        "(^|-)dev($|-)",
        "develop",
        "engineer",
        "coder",
        "programm",
        "implement",
        "build",
        "specialist",
        "expert",
        "frontend",
        "backend",
        "fullstack",
        "mobile",
        "flutter",
        "kotlin",
        "swift",
        "android",
        "(^|-)ios",
        "node",
        "python",
        "java",
        "react",
        "(^|-)sql",
        "golang",
        "rust",
        "(^|-)web($|-)",
        "general",
        "worker"
      ],
      "tasks": [
        "Writes and changes code",
        "Builds features, test first"
      ]
    }
  },
